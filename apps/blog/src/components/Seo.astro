---
// 이관 전 Next metadata(app/layout.tsx 기본값 + 페이지별)와 같은 head 태그
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: 'index' | 'noindex' | 'noindex-nofollow' | 'noindex-follow';
  og?: { type: 'website' | 'article'; url?: string; image?: string; imageAlt?: string; imageWidth?: number; imageHeight?: number; siteName?: string; locale?: string; publishedTime?: string; modifiedTime?: string; authors?: string[]; tags?: string[] } | null;
  keywords?: boolean;
}
const { title, description, canonical, robots = 'index', og = null, keywords = true } = Astro.props;
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="application-name" content="미온 블로그" />
<meta name="author" content="Mion" />
{keywords && <meta name="keywords" content="블로그,개발,Next.js,TypeScript,프론트엔드" />}
<meta name="creator" content="Mion" />
{robots === 'index' && <meta name="robots" content="index, follow" />}
{robots === 'index' && <meta name="googlebot" content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />}
{robots === 'noindex' && <meta name="robots" content="noindex" />}
{robots === 'noindex-follow' && <meta name="robots" content="noindex, follow" />}
{robots === 'noindex-follow' && <meta name="googlebot" content="noindex, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1" />}
{robots === 'noindex-nofollow' && <meta name="robots" content="noindex, nofollow" />}
{robots === 'noindex-nofollow' && <meta name="googlebot" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical} />}
{og && <meta property="og:title" content={title} />}
{og && description && <meta property="og:description" content={description} />}
{og?.url && <meta property="og:url" content={og.url} />}
{og?.siteName && <meta property="og:site_name" content={og.siteName} />}
{og?.locale && <meta property="og:locale" content={og.locale} />}
{og?.image && <meta property="og:image" content={og.image} />}
{og?.image && og.imageWidth && <meta property="og:image:width" content={String(og.imageWidth)} />}
{og?.image && og.imageHeight && <meta property="og:image:height" content={String(og.imageHeight)} />}
{og?.image && og.imageAlt && <meta property="og:image:alt" content={og.imageAlt} />}
{og && <meta property="og:type" content={og.type} />}
{og?.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
{og?.modifiedTime && <meta property="article:modified_time" content={og.modifiedTime} />}
{og?.authors?.map((a) => <meta property="article:author" content={a} />)}
{og?.tags?.map((t) => <meta property="article:tag" content={t} />)}
{og && <meta name="twitter:card" content="summary_large_image" />}
{og && <meta name="twitter:title" content={title} />}
{og && description && <meta name="twitter:description" content={description} />}
{og?.image && <meta name="twitter:image" content={og.image} />}
