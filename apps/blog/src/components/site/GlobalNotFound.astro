---
import Site from '../../layouts/Site.astro';
import Seo from '../Seo.astro';
---
<Site>
  <Seo slot="head" title="페이지를 찾을 수 없습니다 | Mion's Blog" description="요청한 페이지가 존재하지 않거나 이동되었습니다." robots="noindex" />
  <main id="main" tabindex="-1">
    <div class="page-head">
      <div class="container">
        <p class="meta">404</p>
        <h1>페이지를 찾을 수 없습니다</h1>
        <p class="lead">요청하신 페이지가 존재하지 않거나 이동되었을 수 있습니다.</p>
        <div class="actions">
          <a href="/" class="btn">홈으로 돌아가기</a>
          <a href="/posts" class="btn">모든 포스트 보기</a>
        </div>
      </div>
    </div>
  </main>
</Site>
