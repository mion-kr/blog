---
import Site from '../../layouts/Site.astro';
import Seo from '../../components/Seo.astro';
import GlobalNotFound from '../../components/site/GlobalNotFound.astro';
import styles from '../../styles/posts.module.css';
import { parsePostsQuery } from '../../lib/posts-query';
import { listCategories, listPosts, listTags } from '../../server/posts/list';
import { formatCompactNumber, pageNumbers, summaryExcerpt, summaryReadingTime } from '../../lib/post-summary';
import { formatKoreanNumericDate, formatReadingTime } from '../../lib/format';
import { siteUrl } from '../../server/env';
import { getReadDb } from '../../server/db';

const params = Astro.url.searchParams;
const query = parsePostsQuery(params);
const DESCRIPTION = '기술 인사이트와 개발 경험을 공유하는 Mion의 블로그 전체 포스트 목록입니다.';
const filtered = ['limit', 'search', 'categorySlug', 'category', 'tagSlug', 'tag', 'sort', 'order', 'sortPreset'].some((k) => params.get(k));
const indexable = !filtered;
const base = siteUrl();
const canonicalPath = indexable && query.page > 1 ? `/posts?page=${query.page}` : '/posts';
const title = query.page > 1 ? `전체 포스트 ${query.page}페이지 | Mion's Blog` : "전체 포스트 | Mion's Blog";

let error: string | null = null;
let result: Awaited<ReturnType<typeof listPosts>> = { items: [], total: 0 };
if (query.invalid) error = '입력 데이터가 올바르지 않습니다.';
// 목록과 사이드바를 한 번의 왕복(병렬)으로 읽는다.
const db = getReadDb();
const [listed, categories, tags] = await Promise.all([
  query.invalid ? null : listPosts({ ...query, published: true }, db).catch((e) => {
    console.error('글 목록 조회 실패', (e as Error).name);
    error = '포스트를 불러오지 못했습니다. 다시 시도해주세요.';
    return null;
  }),
  listCategories({ limit: 50, sort: 'postCount', order: 'desc' }, db).then((r) => r.items.filter((c) => c.postCount > 0)).catch(() => []),
  listTags({ limit: 30, sort: 'postCount', order: 'desc' }, db).then((r) => r.items).catch(() => []),
]);
if (listed) result = listed;
const totalPages = query.limit > 0 ? Math.ceil(result.total / query.limit) : 0;
const notFound = !error && query.page > 1 && query.page > totalPages;
if (notFound) Astro.response.status = 404;

const hasActiveFilters = Boolean(query.search || query.categorySlug || query.tagSlug);
const presetParam = params.get('sortPreset');
const sortPreset = presetParam === 'latest' || presetParam === 'viewed' || presetParam === 'liked' ? presetParam : query.sort === 'viewCount' ? 'viewed' : 'latest';
const activeCategory = params.get('categorySlug') ?? params.get('category') ?? '';
const activeTag = params.get('tagSlug') ?? params.get('tag') ?? '';

function href(updates: Record<string, string | null>) {
  const next = new URLSearchParams(params);
  if ('categorySlug' in updates) next.delete('category');
  if ('tagSlug' in updates) next.delete('tag');
  for (const [k, v] of Object.entries(updates)) (v ? next.set(k, v) : next.delete(k));
  const q = next.toString();
  return q ? `/posts?${q}` : '/posts';
}
const pageHref = (p: number) => href({ page: String(p) });
const hasPrev = query.page > 1;
const hasNext = query.page < totalPages;
---
{notFound ? <GlobalNotFound /> : (
<Site activePath="/posts">
  <Seo slot="head" title={title} description={DESCRIPTION} canonical={`${base}${canonicalPath}`} robots={indexable ? 'index' : 'noindex-follow'}
    og={{ type: 'website', url: `${base}${canonicalPath}`, image: `${base}/og/blog.png`, imageWidth: 1200, imageHeight: 630, imageAlt: 'Mion 기술 블로그 포스트 목록 공유 이미지' }} />
  <main id="main" class={styles.root}>
    <div class="page-head"><div class="container"><h1>포스트</h1></div></div>
    <div class="container list-layout">
      <div class="list-main">
        {error ? (
          <div class="state state--error" role="alert">
            <h3>포스트를 불러올 수 없습니다</h3>
            <p>{error}</p>
            <button type="button" class="btn btn--primary" onclick="location.reload()">Retry</button>
          </div>
        ) : (
          <>
            <div class="filter" role="group" aria-label="포스트 필터" data-posts-filter>
              <div class="field">
                <label for="q">포스트 검색</label>
                <input id="q" type="text" value={query.search ?? ''} placeholder="관심 있는 기술 키워드를 입력해보세요…" />
              </div>
              <div class="field">
                <label for="sort">정렬</label>
                <select id="sort">
                  <option value="latest" selected={sortPreset === 'latest'}>Latest Updates</option>
                  <option value="viewed" selected={sortPreset === 'viewed'}>Most Viewed</option>
                  <option value="liked" selected={sortPreset === 'liked'}>Most Liked</option>
                </select>
              </div>
            </div>
            {sortPreset === 'liked' && <p class="note" role="status">Most Liked는 준비 중이에요. 최신순으로 표시합니다.</p>}
            {hasActiveFilters && (
              <div class="note"><span role="status">필터 적용됨</span><a class="btn" href="/posts">Reset</a></div>
            )}
            {result.items.length > 0 ? (
              <ol class="entries">
                {result.items.map((post) => {
                  const date = post.publishedAt ?? post.createdAt;
                  return (
                    <li class="entry">
                      <figure class="fig cover" data-slot="entry">
                        {post.coverImage && <img src={post.coverImage} alt="" loading="lazy" sizes="(max-width: 640px) 100vw, 240px" style="position:absolute;height:100%;width:100%;inset:0" />}
                      </figure>
                      <div class="entry-body">
                        <div class="entry-meta">
                          <a href={`/posts?categorySlug=${post.category.slug}`}>{post.category.name}</a>
                          <time class="num" datetime={date.toISOString()}>{formatKoreanNumericDate(date)}</time>
                        </div>
                        <h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2>
                        <p>{summaryExcerpt(post)}</p>
                        <div class="entry-foot">
                          <div class="chips">{post.tags.slice(0, 3).map((tag) => <a class="chip" href={`/posts?tagSlug=${tag.slug}`}>{tag.name}</a>)}</div>
                          <div class="stats">
                            <span class="num">조회 {formatCompactNumber(post.viewCount)}</span>
                            <span class="num">{formatReadingTime(summaryReadingTime(post.content))}</span>
                          </div>
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ol>
            ) : (
              <div class="state">
                <h3>{hasActiveFilters ? '검색 결과가 없습니다' : '등록된 포스트가 없습니다'}</h3>
                <p>{hasActiveFilters ? '다른 검색어/정렬을 시도해보세요.' : '새로운 포스트가 등록되면 이곳에 표시됩니다.'}</p>
                {hasActiveFilters && <a class="btn" href="/posts">Reset</a>}
              </div>
            )}
            {result.items.length > 0 && totalPages > 1 && (
              <nav class="pager" aria-label="페이지네이션">
                {hasPrev ? <a href={pageHref(query.page - 1)} class="btn">이전</a> : <span class="btn" aria-disabled="true">이전</span>}
                {pageNumbers(query.page, totalPages).map((p) =>
                  p === 'ellipsis' ? <span class="btn" aria-disabled="true" aria-hidden="true">…</span>
                  : p === query.page ? <span class="btn num" aria-current="page">{p}<span class="visually-hidden">, 현재 페이지</span></span>
                  : <a href={pageHref(p)} class="btn num" aria-label={`페이지 ${p}`}>{p}</a>)}
                {hasNext ? <a href={pageHref(query.page + 1)} class="btn">다음</a> : <span class="btn" aria-disabled="true">다음</span>}
              </nav>
            )}
          </>
        )}
      </div>
      <aside class="list-side" aria-label="사이드바">
        <section class="side-block" aria-labelledby="cat-h">
          <h2 id="cat-h">Categories</h2>
          {categories.length > 0 ? (
            <ul class="cat-list">
              {categories.map((c) => <li><a href={href({ categorySlug: c.slug, page: '1' })} aria-current={c.slug === activeCategory ? 'true' : undefined}>{c.name}<span class="num">{c.postCount || 0}</span></a></li>)}
            </ul>
          ) : <p class="note">카테고리가 없어요.</p>}
        </section>
        <section class="side-block" aria-labelledby="tag-h">
          <h2 id="tag-h">Popular Tags</h2>
          {tags.length > 0 ? (
            <div class="chips">
              {tags.map((t) => <a class="chip" href={href({ tagSlug: t.slug === activeTag ? null : t.slug, page: '1' })} aria-current={t.slug === activeTag ? 'true' : undefined}>{t.name}</a>)}
            </div>
          ) : <p class="note">태그가 없어요.</p>}
        </section>
      </aside>
    </div>
  </main>
  <script>
    import '../../scripts/posts-filter';
  </script>
</Site>
)}
