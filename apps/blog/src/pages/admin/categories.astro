---
import Admin from '../../layouts/Admin.astro';
import { StatusBanner } from '../../islands/AdminPosts';
import { CategoriesContent } from '../../islands/AdminTaxonomy';
import { listCategories } from '../../server/posts/list';

// 이관 전 get-admin-categories.ts: 20개씩, 이름 오름차순, 이름 검색
const params = Astro.url.searchParams;
const searchParams = Object.fromEntries(params.entries());
const pageNumber = Number(params.get('page') ?? '1');
const search = params.get('search')?.trim() ?? '';
const query = { page: Number.isNaN(pageNumber) ? 1 : pageNumber, limit: 20, order: 'asc' as const, sort: 'name' as const, search: search || undefined };
let data = null;
let error: string | null = null;
try {
  const result = await listCategories(query);
  data = { categories: result.items, total: result.total, query };
} catch (e) {
  console.error('categories 목록 조회 실패', (e as Error).name);
  error = '카테고리 목록을 불러오지 못했어요.';
}
const baseQuery = new URLSearchParams({ ...(search ? { search } : {}), ...(params.get('page') ? { page: params.get('page')! } : {}), modal: 'create' });
---
<Admin>
  <div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-2xl font-semibold text-slate-50">카테고리 관리</h2>
        <p class="text-sm text-slate-500">콘텐츠 분류를 생성하고 정리하세요.</p>
      </div>
      <a href={`/admin/categories?${baseQuery.toString()}`} class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-200 transition hover:bg-emerald-500/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen h-4 w-4" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg> 새 카테고리
      </a>
    </div>
    <StatusBanner client:load url={Astro.url.href} status={params.get('status')} message={params.get('message')} />
    <form class="grid gap-4 rounded-xl border border-slate-800 bg-slate-900/40 p-4 md:grid-cols-[1fr_auto]">
      <div class="grid gap-2">
        <label for="search" class="text-xs font-medium text-slate-300">검색어</label>
        <input id="search" name="search" placeholder="카테고리 이름 또는 설명" value={search} class="rounded-lg border border-slate-800 bg-slate-950 px-3 py-2 text-sm text-slate-100 focus:border-emerald-400 focus:outline-none" />
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-medium text-emerald-950 transition hover:bg-emerald-400">검색</button>
        <a href="/admin/categories" class="rounded-lg border border-slate-700 px-3 py-2 text-sm text-slate-300 transition hover:border-slate-500 hover:text-slate-100">초기화</a>
      </div>
    </form>
    <CategoriesContent client:load url={Astro.url.href} searchParams={searchParams} data={data as never} error={error} />
  </div>
</Admin>
