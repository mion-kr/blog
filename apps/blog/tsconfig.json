{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@repo/shared": [
        "src/shared/index.ts"
      ],
      "next/link": [
        "src/shims/next-link.tsx"
      ],
      "next/navigation": [
        "src/shims/next-navigation.tsx"
      ],
      "next/image": [
        "src/shims/next-image.tsx"
      ]
    }
  }
}
