{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mion-blog",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "ROBOTS_INDEXABLE": "false",
    "MEDIA_BASE_URL": "http://localhost:4321/local-media/",
    "SERVE_MEDIA_FROM_BINDING": "true",
    "ADMIN_WRITES_FROZEN": "false",
    "RSS_ITEMS_LIMIT": "50",
    "UPLOAD_ALLOWED_MIME": "image/jpeg,image/png,image/webp",
    "UPLOAD_MAX_SIZE": "10485760"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mion-blog", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "mion-blog-media" }]
}
