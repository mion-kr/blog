{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check-types": "astro check",
    "test": "astro build && vitest run",
    "test:unit": "vitest run --project unit",
    "migrate:dump": "node scripts/migrate/dump.ts",
    "migrate:sql": "node scripts/migrate/build-sql.ts",
    "migrate:load:local": "wrangler d1 migrations apply mion-blog --local && wrangler d1 execute mion-blog --local --file .migration/clear.sql && wrangler d1 execute mion-blog --local --file .migration/load.sql",
    "migrate:compare:local": "node scripts/migrate/compare.ts --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.4",
    "@astrojs/react": "7.1.2",
    "astro": "7.4.5",
    "drizzle-orm": "0.45.4",
    "hangul-romanize": "0.3.2",
    "jose": "6.2.15",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.7",
    "typescript": "5.9.2",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
